{
  "requiredMinimumVersion": "2.1.324",

  "extraKnownMarketplaces": {
    "claude-code-guardrails": {
      "source": {
        "source": "github",
        "repo": "YOUR-GITHUB-ORG/claude-code-guardrails",
        "ref": "REPLACE-WITH-THE-40-CHARACTER-COMMIT-SHA-YOU-REVIEWED"
      }
    }
  },
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "YOUR-GITHUB-ORG/claude-code-guardrails",
      "ref": "REPLACE-WITH-THE-40-CHARACTER-COMMIT-SHA-YOU-REVIEWED"
    }
  ],
  "disableSideloadFlags": true,

  "enabledPlugins": {
    "terraform-guard@claude-code-guardrails": true,
    "aws-guard@claude-code-guardrails": true,
    "tf-lint@claude-code-guardrails": true,
    "secret-allow-guard@claude-code-guardrails": true,
    "secret-read-guard@claude-code-guardrails": true
  },
  "prependPlugins": [
    "terraform-guard@claude-code-guardrails",
    "aws-guard@claude-code-guardrails",
    "tf-lint@claude-code-guardrails",
    "secret-allow-guard@claude-code-guardrails",
    "secret-read-guard@claude-code-guardrails",
    "sec-default@builtin"
  ],

  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(//**/*.tfstate)",
      "Read(//**/*.tfstate.*)",
      "Read(//**/*.tfvars)",
      "Read(//**/*.tfvars.json)",
      "Read(//**/*.pem)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.azure/**)",
      "Read(~/.identityservice/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/AppData/Roaming/gcloud/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Read(~/_netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.pgpass)",
      "Read(~/.vault-token)",
      "Read(~/.terraformrc)",
      "Read(~/AppData/Roaming/terraform.rc)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.ppk)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "mcp__terminal__run_in_terminal",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "PowerShell(git push --force)",
      "PowerShell(git push --force *)",
      "PowerShell(git push * --force)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude.json)"
    ]
  },

  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [],

  "forceLoginMethod": "claudeai",
  "forceLoginOrgUUID": "REPLACE-WITH-YOUR-ORG-UUID",

  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowManagedReadPathsOnly": true
    },
    "network": {
      "allowManagedDomainsOnly": true,
      "allowedDomains": [
        "github.com",
        "registry.terraform.io",
        "releases.hashicorp.com",
        "*.amazonaws.com"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "VAULT_TOKEN", "mode": "deny" },
        { "name": "AZURE_CLIENT_SECRET", "mode": "deny" },
        { "name": "GOOGLE_APPLICATION_CREDENTIALS", "mode": "deny" }
      ]
    }
  },

  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel-collector.example.com:4317",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  },

  "cleanupPeriodDays": 30,
  "desktopSessionCleanupPeriodDays": 30,
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off"
}
